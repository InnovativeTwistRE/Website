# Copy to .env and fill in real values locally. Never commit the real .env file.
# Per docs/environment-configuration.md and docs/secrets-key-management-v1.md.

# --- Database (packages/database) ---
DATABASE_URL="postgresql://user:password@localhost:5432/innovative_twist_dev"

# --- Better Auth (packages/auth) ---
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- Object storage (packages/integrations storage adapter) ---
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- AI provider access (packages/ai only) ---
AI_PROVIDER=""
AI_API_KEY=""

# --- apps/worker ---
WORKER_QUEUE_POLL_INTERVAL_MS="5000"

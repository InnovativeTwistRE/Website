{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@innovative-twist/ai": "workspace:*",
    "@innovative-twist/config": "workspace:*",
    "@innovative-twist/database": "workspace:*",
    "@innovative-twist/domain": "workspace:*",
    "@innovative-twist/integrations": "workspace:*",
    "@innovative-twist/reports": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
